# ---------- PawNest backend configuration ----------
PORT=5000
NODE_ENV=development

# MongoDB. Local install: mongodb://127.0.0.1:27017/pawnest  |  Atlas: your mongodb+srv:// string
MONGODB_URI=mongodb://127.0.0.1:27017/pawnest

# If MongoDB is not reachable and the embedded option is installed, PawNest starts an embedded
# MongoDB instead (run "npm run install:memory-db" inside /backend once). Set to true to always use it.
# Data is kept in backend/.mongo-data
USE_MEMORY_DB=false

# Auth
JWT_SECRET=64c37f2db628c397bc2085cb67f6b07cffd91e61335db1e3173968fb67d48fac
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS in development
CLIENT_URL=http://localhost:5173

# PawAI - the key lives ONLY here on the backend. Leave empty for the built-in basic mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fill the database with demo data (products, brands, reviews, orders, users) when it is empty
AUTO_SEED=true
