{
  "name": "pawnest-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/seed/run.js",
    "seed:reset": "node src/seed/run.js --reset",
    "images": "node scripts/generate-product-images.js",
    "install:memory-db": "npm install mongodb-memory-server --no-save --no-audit --no-fund",
    "postinstall": "node scripts/ensure-env.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1"
  }
}
